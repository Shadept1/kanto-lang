{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KantoLang",
  "scopeName": "source.kantolang",
  "fileTypes": ["knt"],
  "injectionSelector": "L:source.kantolang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control",
          "match": "\\b(if|else|while|for|in|break|continue|ret)\\b"
        },
        {
          "name": "keyword.declaration",
          "match": "\\b(let|mut|def)\\b"
        },
        {
          "name": "keyword.operator.logical",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type",
          "match": "\\b(int|float|bool|str|unit)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function",
          "match": "\\b(print|range|str|int|float)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.float",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\([nrt\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "punctuation.separator",
          "match": "[,:]"
        },
        {
          "name": "keyword.operator.type",
          "match": "->"
        },
        {
          "name": "punctuation.definition.parameters",
          "match": "[()]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}